# =============================================================================
# .env.example — 环境变量模板
# 复制为 .env 后填写真实值
# =============================================================================

# ---------- Application ----------
APP_NAME=TableTennisAnalysis
ENV=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://tta_user:tta_pass_dev@localhost:5432/tta
POSTGRES_DB=tta
POSTGRES_USER=tta_user
POSTGRES_PASSWORD=tta_pass_dev
# 数据库连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_pass
REDIS_URL=redis://:redis_dev_pass@localhost:6379/0

# ---------- JWT（强制必填，无默认值，缺失则应用拒绝启动）----------
JWT_SECRET_KEY=please-generate-a-32-byte-secret-key
JWT_REFRESH_SECRET_KEY=please-generate-another-32-byte-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- WeChat Mini Program ----------
WECHAT_APPID=your-wechat-appid
WECHAT_APP_SECRET=your-wechat-app-secret

# ---------- WeChat Pay (S5) ----------
# WECHAT_API_V3_KEY=
# WECHAT_PRIVATE_KEY=
# WECHAT_MCH_ID=
# WECHAT_APP_ID=
# WECHAT_NOTIFY_URL=

# ---------- OSS (S3) ----------
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET_NAME=
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_CDN_DOMAIN=

# ---------- AI Inference (S3) ----------
# INFERENCE_BASE_URL=http://localhost:8501
# INFERENCE_TIMEOUT=300

# ---------- Celery (S2+) ----------
CELERY_BROKER_URL=redis://:redis_dev_pass@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_dev_pass@localhost:6379/2

# ---------- SMS (S6) ----------
SMS_MOCK=true
# ALIYUN_SMS_ACCESS_KEY=
# ALIYUN_SMS_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
