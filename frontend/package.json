{
  "name": "pingpong-ai-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "乒乓智能分析平台小程序前端（Taro 4 + React + TypeScript）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "new": "taro new",
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e --ext .ts,.tsx --max-warnings 200",
    "test": "jest"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@nutui/nutui-react-taro": "^2.7.14",
    "@tarojs/components": "4.3.2",
    "@tarojs/helper": "4.3.2",
    "@tarojs/plugin-framework-react": "4.3.2",
    "@tarojs/plugin-platform-h5": "4.3.2",
    "@tarojs/plugin-platform-weapp": "4.3.2",
    "@tarojs/react": "4.3.2",
    "@tarojs/runtime": "4.3.2",
    "@tarojs/shared": "4.3.2",
    "@tarojs/taro": "4.3.2",
    "i18next": "^26.7.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-i18next": "^17.1.12",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@playwright/test": "^1.65.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "4.3.2",
    "@tarojs/plugin-generator": "4.3.2",
    "@tarojs/taro-loader": "4.3.2",
    "@tarojs/webpack5-runner": "4.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^18",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-preset-taro": "4.3.2",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "sass": "^1.75.0",
    "ts-jest": "^29.4.15",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.4.5",
    "webpack": "5.91.0"
  }
}
